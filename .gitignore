# Ignore node_modules everywhere
**/node_modules/

# Ignore build outputs
**/dist/
**/build/

# Ignore environment files
**/.env
**/.env.*      # e.g. .env.local, .env.development, etc.

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE/editor specific
.vscode/
.idea/
.DS_Store
*.swp

# OS specific
Thumbs.db

# Optional: if you use Next.js
.next/
out/

# Optional: if you use coverage tools
coverage/

# Optional: if you use TypeScript
*.tsbuildinfo
